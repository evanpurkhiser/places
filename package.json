{
  "name": "places",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Evan Purkhiser",
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "server": "pnpm --filter @places/server start",
    "places": "pnpm --filter @places/cli start",
    "worker": "pnpm --filter @places/server worker"
  },
  "devDependencies": {
    "@evanpurkhiser/oxc-config": "^0.8.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0"
    }
  }
}
